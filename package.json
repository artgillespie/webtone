{
  "name": "webtone",
  "version": "0.1.0",
  "description": "A browser FM/wavetable groovebox workstation inspired by the Elektron Digitone II. Zero runtime dependencies.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node --test test/*.test.js",
    "render": "node tools/render.mjs",
    "describe": "node tools/describe.mjs",
    "bench": "node tools/bench.mjs",
    "preview": "npx wrangler@4 dev --port 8787",
    "deploy": "npm test && npx wrangler@4 deploy"
  },
  "engines": {
    "node": ">=20"
  }
}
